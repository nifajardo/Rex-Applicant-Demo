# Main Supabase Configuration
# Get these values from your Supabase project dashboard
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# External Supabase Configuration (for announcements or other external data)
# Only needed if you're using an external Supabase instance
VITE_EXTERNAL_SUPABASE_URL=your_external_supabase_url_here
VITE_EXTERNAL_SUPABASE_ANON_KEY=your_external_supabase_anon_key_here

# Development Configuration
NODE_ENV=development

# Template/Banner Configuration (for production builds)
# Uncomment and set these for production template functionality
# TEMPLATE_BANNER_SCRIPT_URL=your_banner_script_url_here
# TEMPLATE_REDIRECT_URL=your_redirect_url_here

# Optional: Additional environment-specific variables
VITE_API_BASE_URL=http://localhost:3000/api
VITE_APP_NAME=CGB Applicant
VITE_DEBUG=false